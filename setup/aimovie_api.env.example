# aifilm 凭据与本机路径。复制到 <WORKSPACE>/.secrets/aimovie_api.env 后填写。
# 该文件由 aifilm_booklet/tools/source_aimovie_env.sh 读取；.secrets/ 已被 .gitignore 排除，切勿提交。

# ---- gpt-image-2 图像网关（S05 资产 / 首帧 / 参考图）----
# 网关需 OpenAI images 兼容接口：POST {endpoint}  /  {endpoint 同级}/edits
export AIMOVIE_IMAGE_APP_ID=""
export AIMOVIE_IMAGE_APP_KEY=""
export AIMOVIE_IMAGE_ENDPOINT=""          # 例：http://<gateway>/v1/images/generations
export AIMOVIE_IMAGE_EDIT_ENDPOINT=""     # 留空则自动用 .../v1/images/edits
export AIMOVIE_IMAGE_MODEL="gpt-image-2"
export AIMOVIE_IMAGE_PROVIDER="openai"

# ---- ElevenLabs ----
# 当前流程不使用外部 TTS / 配音；但 source_aimovie_env.sh 会检查这两项非空，没有账号可填任意占位值。
export ELEVENLABS_APP_ID="unused"
export ELEVENLABS_APP_KEY="unused"
export ELEVENLABS_BASE_URL=""
export ELEVENLABS_MODEL=""

# ---- conda（tools/run_seedvr2_upscale.sh 使用）----
export CONDA_ACTIVATE="$HOME/miniconda3/bin/activate"
export CONDA_ENV="minimaxh3"

# ---- CloudBase 公网审查页（S06，examples/car_chat/pipeline/build_review_site.py 读取）----
export CLOUDBASE_ENV_ID=""
export CLOUDBASE_BUCKET=""
export CLOUDBASE_DOC_ID=""                # 每个项目唯一
export CLOUDBASE_API_URL=""               # https://<env>-<uin>.<region>.app.tcloudbase.com/storyboard-api
export CLOUDBASE_DEPLOY_PATH=""           # 例：/car-chat-demo

# ---- 可选 ----
# export HF_TOKEN=""
# export HF_ENDPOINT="https://hf-mirror.com"
# export NODE_IP_LIST=""                  # 仅集群环境 tools/dist_stop_gpu.sh 使用
